# Copy to .env.local and fill in. Never commit .env.local itself.

# Canonical site URL (used for sitemap, robots, OG tags)
NEXT_PUBLIC_SITE_URL=https://justwannaleave.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Sanity CMS (sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Resend email capture (resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_AUDIENCE_ID=your_audience_id_here
